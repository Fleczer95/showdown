# Prettier has no .gitignore awareness, so everything not hand-written has to be
# listed here or `format:check` reports thousands of files it should never touch.

# --- Generated by expo prebuild -------------------------------------------
# Both are regenerated from app.json + config plugins on every `prebuild`, so
# formatting them produces churn that the next build throws away.
/android/
/ios/

# --- Generated by scripts -------------------------------------------------
# Written by scripts/generate-packs.mjs (JSON.stringify output).
/assets/packs/

# --- Dependency and lock files -------------------------------------------
node_modules/
package-lock.json
/server/package-lock.json

# --- Build, test and tooling output --------------------------------------
/coverage/
/.expo/
/dist/
/build/
/scratch/
/.idea/

# --- Python virtualenvs ---------------------------------------------------
/.venv/
/.venv-agents/
/.venv-store/

# --- Nested sub-project (own toolchain, own build output) ----------------
/aso/screenshot-generator/

# --- Agent tooling config (vendored/symlinked, not ours to format) -------
/.agents/

# --- Question banks: one entry per line, deliberately ---------------------
# Each question/puzzle is a single line so a whole bank can be scanned and
# diffed entry-by-entry, which is what the content-authoring and question-audit
# workflows rely on. Prettier at printWidth 120 would split every entry across
# ~10 lines and inflate these files roughly tenfold.
/src/game/*/content*.ts
/src/game/*/packs/

# --- Deployed verbatim ----------------------------------------------------
# Served byte-for-byte from showdown.lebene.pl (ADR-0003); Apple caches the
# AASA, so a formatter should not be rewriting these.
/static/
